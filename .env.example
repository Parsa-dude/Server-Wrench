# Server Wrench — configuration
# Copy this file to ".env" (next to bot.py) and fill in the first two lines:
#     cp .env.example .env && chmod 600 .env

# 1) The token of your bot, from @BotFather.
#    One bot per server: two servers must not share a token.
BOT_TOKEN=

# 2) Telegram user IDs that may use the bot, comma separated.
#    Don't know yours? Leave this empty, start the bot and send it /start — it tells you.
ADMIN_IDS=

# ───────────── everything below is optional ─────────────

# Language for alerts and for admins who have not picked one: auto | en | fa
# (auto = the language of each admin's Telegram app; anyone can switch in Settings)
#LANGUAGE=auto

# Time zone for reports and schedules (default: the server's own zone, else UTC)
#TIMEZONE=Europe/Amsterdam

# Big files — send one file of up to 2 GB instead of 45 MB parts.
# Get both values at https://my.telegram.org → "API development tools", then run:
#     venv/bin/pip install -r requirements-bigfiles.txt cryptg
#API_ID=
#API_HASH=
#BIG_PART_MB=1900

# Extra folders to offer under "Extra paths" (comma separated)
#EXTRA_PATHS=/var/log,/backup

# Extra parent folders whose sub-folders are checked for projects. This also works for
# places the bot leaves alone otherwise, such as /var/lib/apps.
#SCAN_PATHS=/mnt/apps

# Folder names and services that should never be listed (comma separated).
# Containers are written as d/<name>.
#IGNORE_DIRS=old,playground
#IGNORE_SERVICES=snapd,d/watchtower

# The built-in "Config folders" group (/etc/nginx, systemd units, crontabs, …): on | off
#SYSTEM_CONFIGS=on

# Limits
# the largest backup or file one job may send, in MB
#MAX_JOB_MB=4096
# free disk space that is always left untouched, in MB
#MIN_FREE_DISK_MB=500
# ceiling of the monitoring history, in MB
#DATA_MAX_MB=10

# Network
# A proxy for reaching Telegram (socks5 needs: venv/bin/pip install "python-telegram-bot[socks]")
#PROXY_URL=socks5://user:pass@127.0.0.1:1080
# Your own Bot API server and its upload limit (the public API allows 50 MB)
#BOT_API_URL=http://127.0.0.1:8081
#BOT_API_LIMIT_MB=2000

# Coloured buttons (Telegram apps that do not know them simply ignore the colour): on | off
#BUTTON_COLORS=on

#LOG_LEVEL=INFO
